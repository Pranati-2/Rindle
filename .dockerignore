# Git files
.git
.gitignore

# Node modules - these are installed during the Docker build
node_modules
client/node_modules

# Build output - this is generated during the Docker build
dist

# Environment files - should not be part of the image
*.env
.env.*
!.env.example # Often good to include an example

# Operating System files
.DS_Store
Thumbs.db

# Log files
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Drizzle migrations directory (if migrations are run externally or via exec)
migrations/

# Docker files themselves
Dockerfile
.dockerignore
