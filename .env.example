# Environment variables for Rindle application

# Database connection URL (PostgreSQL)
# Example for local Docker PostgreSQL container:
# DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>"
# Replace <user>, <password>, <host>, <port>, <database> with your PostgreSQL container details.
# For the recommended Docker setup (see DOCKER_SETUP.md), if PostgreSQL is running in a container named 'rindle-db':
# user: postgres (default for postgres image if not changed)
# password: mysecretpassword (example from DOCKER_SETUP.md)
# host: rindle-db (service name when linking containers or on user-defined Docker network)
# port: 5432 (default PostgreSQL port)
# database: postgres (default database for postgres image if not changed)
DATABASE_URL="postgresql://postgres:mysecretpassword@rindle-db:5432/postgres"

# Port the application server will listen on (internally in the container)
# This is also set in the Dockerfile and server code.
# Primarily for reference or if you were to run without Docker and needed to set it.
PORT=5000
